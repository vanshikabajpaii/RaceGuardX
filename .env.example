# ========================================================
# RaceGuardX Environment Configuration Template
# "Every Request. Every Seat. Under Control."
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
# Provide your PostgreSQL connection string (direct or Supabase pooler):
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raceguardx

# Supabase (Optional, if using Supabase client libraries)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security & Authentication
JWT_SECRET=raceguardx_production_jwt_secret_change_me_in_env

# Initial Seed Credentials (Used only by seed.js)
SEED_STUDENT_PASSWORD=Student@Pass123
SEED_ADMIN_PASSWORD=Admin@SecurePass123
